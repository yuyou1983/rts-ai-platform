{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Held-Out Suite",
  "type": "object",
  "required": ["skill_name", "scenarios"],
  "properties": {
    "skill_name": {"type": "string"},
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "description", "validation_commands", "pass_criteria"],
        "properties": {
          "id": {"type": "string", "pattern": "^held-out/"},
          "description": {"type": "string"},
          "fixture_files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "expected_findings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["axis", "allowed_verdicts"],
              "properties": {
                "axis": {"type": "string"},
                "allowed_verdicts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": ["PASS", "CONCERNS", "FAIL", "NOT AVAILABLE", "NOT APPLICABLE"]
                  }
                }
              }
            }
          },
          "validation_commands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "pass_criteria": {"type": "string"}
        }
      }
    }
  }
}
