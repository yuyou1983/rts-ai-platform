{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Held-Out Suite",
  "type": "object",
  "required": ["skill_name", "scenarios"],
  "properties": {
    "skill_name": {"type": "string"},
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "description", "validation_commands", "pass_criteria"],
        "properties": {
          "id": {"type": "string", "pattern": "^held-out/"},
          "description": {"type": "string"},
          "validation_commands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "pass_criteria": {"type": "string"}
        }
      }
    }
  }
}
