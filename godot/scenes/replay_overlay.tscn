[node name="HSlider" type="HSlider" parent="VBoxContainer"]
layout_mode = 2
min_value = 0.0
max_value = 100.0
step = 1.0

[node name="ButtonRow" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
alignment = 1

[node name="BtnStart" type="Button" parent="VBoxContainer/ButtonRow"]
layout_mode = 2
